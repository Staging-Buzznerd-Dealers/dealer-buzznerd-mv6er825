{
  "version": 2,
  "id": "utility-bar",
  "name": "Utility bar",
  "description": "The thin dark strip above the header: main phone and address on the left, a short menu and social icons on the right.",
  "css": "/* Styled in the site template (Templates → Site template → Custom code) so the same rules reach the /store inventory pages. */",
  "props": [
    {
      "key": "phone",
      "type": "text",
      "label": "Main phone",
      "default": "(555) 010-0148"
    },
    {
      "key": "phoneUrl",
      "type": "url",
      "label": "Phone link",
      "default": "tel:+15550100148"
    },
    {
      "key": "address",
      "type": "text",
      "label": "Main address",
      "default": "1250 Commerce Parkway, Riverton, TX 75001"
    },
    {
      "key": "facebook",
      "type": "url",
      "label": "Facebook link (empty hides it)"
    },
    {
      "key": "instagram",
      "type": "url",
      "label": "Instagram link (empty hides it)"
    },
    {
      "key": "linkedin",
      "type": "url",
      "label": "LinkedIn link (empty hides it)"
    },
    {
      "key": "x",
      "type": "url",
      "label": "X link (empty hides it)"
    },
    {
      "key": "youtube",
      "type": "url",
      "label": "YouTube link (empty hides it)"
    }
  ],
  "nodes": [
    {
      "id": "ub",
      "type": "section",
      "props": {
        "width": "full",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "background": "inkDark",
          "paddingTop": 9,
          "paddingBottom": 9,
          "paddingLeft": 24,
          "paddingRight": 24
        }
      },
      "children": [
        {
          "id": "ub-row",
          "type": "row",
          "props": {
            "gap": 4,
            "align": "center",
            "stackOn": "never"
          },
          "children": [
            {
              "id": "ub-left",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-contact",
                  "type": "text",
                  "props": {
                    "text": "<a href=\"{{phoneUrl}}\">{{phone}}</a>{{address}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "ub-right",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "utility",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  }
                },
                {
                  "id": "ub-social",
                  "type": "social-links",
                  "props": {
                    "facebook": "{{facebook}}",
                    "instagram": "{{instagram}}",
                    "linkedin": "{{linkedin}}",
                    "x": "{{x}}",
                    "youtube": "{{youtube}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
