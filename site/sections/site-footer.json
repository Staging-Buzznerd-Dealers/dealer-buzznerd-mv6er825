{
  "version": 2,
  "id": "site-footer",
  "name": "Site footer",
  "description": "Dark footer: logo, a short description and social icons, three link columns, and a bottom bar with copyright and legal links.",
  "css": "/* Styled in the site template (Templates → Site template → Custom code) so the same rules reach the /store inventory pages. */",
  "props": [
    {
      "key": "logo",
      "type": "image",
      "label": "Logo (light, for the dark background)",
      "default": {
        "src": "/logo-white.svg",
        "alt": "Summit Ridge Truck Center",
        "width": 260,
        "height": 48
      }
    },
    {
      "key": "blurb",
      "type": "textarea",
      "label": "Description",
      "default": "Summit Ridge Truck Center is an independent commercial truck dealer offering new and pre-owned trucks, certified service and OEM parts. With locations across Texas and Oklahoma, we keep fleets and owner-operators on the road."
    },
    {
      "key": "copyright",
      "type": "text",
      "label": "Copyright line",
      "default": "© 2026 Summit Ridge Truck Center. All rights reserved."
    },
    {
      "key": "facebook",
      "type": "url",
      "label": "Facebook link (empty hides it)"
    },
    {
      "key": "instagram",
      "type": "url",
      "label": "Instagram link (empty hides it)"
    },
    {
      "key": "linkedin",
      "type": "url",
      "label": "LinkedIn link (empty hides it)"
    },
    {
      "key": "x",
      "type": "url",
      "label": "X link (empty hides it)"
    },
    {
      "key": "youtube",
      "type": "url",
      "label": "YouTube link (empty hides it)"
    },
    {
      "key": "builtByLogo",
      "type": "image",
      "label": "\"Built by\" logo",
      "default": {
        "src": "/images/buzznerd-logo.png",
        "alt": "BuzzNerd",
        "width": 480,
        "height": 100
      }
    },
    {
      "key": "builtByUrl",
      "type": "url",
      "label": "\"Built by\" link",
      "default": "https://buzznerd.com"
    }
  ],
  "nodes": [
    {
      "id": "ft",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8,
        "background": "ink"
      },
      "children": [
        {
          "id": "ft-main",
          "type": "row",
          "props": {
            "gap": 7,
            "align": "start",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "ft-brand",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "ft-logo",
                  "type": "image",
                  "props": {
                    "image": "{{logo}}",
                    "url": "/"
                  }
                },
                {
                  "id": "ft-blurb",
                  "type": "text",
                  "props": {
                    "text": "{{blurb}}",
                    "width": "full"
                  }
                },
                {
                  "id": "ft-social",
                  "type": "social-links",
                  "props": {
                    "facebook": "{{facebook}}",
                    "instagram": "{{instagram}}",
                    "linkedin": "{{linkedin}}",
                    "x": "{{x}}",
                    "youtube": "{{youtube}}"
                  }
                }
              ]
            },
            {
              "id": "ft-links",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "ft-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "footer",
                    "layout": "vertical",
                    "depth": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "ft-bottom",
          "type": "row",
          "props": {
            "gap": 4,
            "align": "center",
            "stackOn": "mobile"
          },
          "children": [
            {
              "id": "ft-copy",
              "type": "column",
              "props": {
                "span": 4
              },
              "children": [
                {
                  "id": "ft-copy-t",
                  "type": "text",
                  "props": {
                    "text": "{{copyright}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "ft-builtby",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "ft-builtby-t",
                  "type": "text",
                  "props": {
                    "text": "Built by",
                    "width": "full"
                  }
                },
                {
                  "id": "ft-builtby-logo",
                  "type": "image",
                  "props": {
                    "image": "{{builtByLogo}}",
                    "url": "{{builtByUrl}}"
                  }
                }
              ]
            },
            {
              "id": "ft-legal",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "ft-legal-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "legal",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
