{
  "version": 2,
  "id": "location-header",
  "name": "Location page header",
  "description": "Dark banner at the top of a location page: breadcrumb, \"Hours & location of …\", the address, and Call / Get directions buttons — all from that rooftop's record in Locations.",
  "css": "[data-bz-section=\"location-header\"] .bz-block { padding-block: 0; }\n[data-bz-section=\"location-header\"] .bz-col[data-bz-node^=\"lh-copy\"] { text-align: center; }\n[data-bz-section=\"location-header\"] .bz-block[data-bz-node^=\"lh-crumb\"] p { font: 700 12px / 1.4 var(--font-body); letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.7); margin: 0 0 14px; }\n[data-bz-section=\"location-header\"] .bz-block[data-bz-node^=\"lh-crumb\"] a { color: inherit; text-decoration: none; }\n[data-bz-section=\"location-header\"] .bz-block[data-bz-node^=\"lh-h\"] h1 { color: #fff; max-width: 22ch; margin-inline: auto; }\n[data-bz-section=\"location-header\"] .bz-block[data-bz-node^=\"lh-addr\"] p { color: rgba(255,255,255,.82); max-width: 60ch; margin: 0 auto; }\n[data-bz-section=\"location-header\"] .bz-btns { justify-content: center; margin-bottom: 0; }\n[data-bz-section=\"location-header\"] .bz-btn { background: #fff; color: var(--ink); border-color: #fff; }\n[data-bz-section=\"location-header\"] .bz-btn + .bz-btn { background: transparent; color: #fff; border-color: rgba(255,255,255,.6); }",
  "props": [
    {
      "key": "locationSlug",
      "type": "text",
      "label": "Location (filled in per page)"
    },
    {
      "key": "rooftop",
      "type": "list",
      "label": "This location",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "subtitle",
          "type": "text",
          "label": "Business name"
        },
        {
          "key": "streetAddress",
          "type": "text",
          "label": "Street address"
        },
        {
          "key": "city",
          "type": "text",
          "label": "City"
        },
        {
          "key": "region",
          "type": "text",
          "label": "State"
        },
        {
          "key": "postalCode",
          "type": "text",
          "label": "ZIP"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link"
        },
        {
          "key": "mapUrl",
          "type": "url",
          "label": "Directions link"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "lh",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 9,
        "background": "ink"
      },
      "children": [
        {
          "id": "lh-row",
          "type": "row",
          "props": {
            "gap": 4
          },
          "children": [
            {
              "id": "lh-copy",
              "type": "column",
              "props": {
                "span": 12,
                "repeat": "rooftop"
              },
              "children": [
                {
                  "id": "lh-crumb",
                  "type": "text",
                  "props": {
                    "text": "<a href=\"/\">Home</a> / <a href=\"/locations\">Locations</a> / {{name}}, {{region}}",
                    "width": "full"
                  }
                },
                {
                  "id": "lh-h",
                  "type": "heading",
                  "props": {
                    "text": "Hours & location of Summit Ridge {{name}}",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "lh-addr",
                  "type": "text",
                  "props": {
                    "text": "{{streetAddress}}, {{city}}, {{region}} {{postalCode}} — trucks, parts and service, with our after-hours team a phone call away.",
                    "width": "full"
                  }
                },
                {
                  "id": "lh-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "Call {{phone}}",
                        "url": "{{phoneUrl}}",
                        "style": "primary",
                        "intent": "call-dealer"
                      },
                      {
                        "label": "Get directions",
                        "url": "{{mapUrl}}",
                        "style": "secondary",
                        "intent": "get-directions"
                      }
                    ],
                    "align": "center"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
