{
  "version": 2,
  "id": "service-hours",
  "name": "Service hours",
  "description": "A label, heading and intro, then one card per location with its department hours and phone (from Locations), and a dark after-hours card.",
  "css": "[data-bz-section=\"service-hours\"] .bz-block { padding-block: 0; }\n[data-bz-section=\"service-hours\"] [data-bz-node=\"sh-intro\"] p { color: #3b3a37; margin: 0; }\n[data-bz-section=\"service-hours\"] .bz-row[data-bz-node=\"sh-grid\"] { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }\n[data-bz-section=\"service-hours\"] .bz-col[data-bz-node^=\"sh-card\"], [data-bz-section=\"service-hours\"] .bz-col[data-bz-node=\"sh-after\"] { grid-column: auto; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-card); padding: 22px 20px 24px; }\n[data-bz-section=\"service-hours\"] .bz-col[data-bz-node=\"sh-after\"] { background: var(--ink); border-color: var(--ink); color: #fff; }\n[data-bz-section=\"service-hours\"] [data-bz-node^=\"sh-name\"] h3, [data-bz-section=\"service-hours\"] [data-bz-node=\"sh-after-h\"] h3 { font-size: 15px; margin: 0 0 12px; }\n[data-bz-section=\"service-hours\"] [data-bz-node=\"sh-after-h\"] h3 { color: #fff; }\n[data-bz-section=\"service-hours\"] .bz-row[data-bz-node^=\"sh-depts\"] { display: block; }\n[data-bz-section=\"service-hours\"] [data-bz-node^=\"sh-dept-t\"] p { font-size: 13.5px; line-height: 1.55; color: #4a4945; margin: 0 0 8px; }\n[data-bz-section=\"service-hours\"] [data-bz-node^=\"sh-phone\"] p { margin: 6px 0 0; }\n[data-bz-section=\"service-hours\"] [data-bz-node^=\"sh-phone\"] a { font: 700 13px / 1.4 var(--font-body); color: var(--ink); text-decoration: none; }\n[data-bz-section=\"service-hours\"] [data-bz-node^=\"sh-phone\"] a:empty { display: none; }\n[data-bz-section=\"service-hours\"] [data-bz-node=\"sh-after-t\"] p { font-size: 13.5px; line-height: 1.6; color: rgba(255,255,255,.85); margin: 0; }\n@media (max-width: 1100px) { [data-bz-section=\"service-hours\"] .bz-row[data-bz-node=\"sh-grid\"] { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 640px) { [data-bz-section=\"service-hours\"] .bz-row[data-bz-node=\"sh-grid\"] { grid-template-columns: minmax(0, 1fr); } }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Label above the heading",
      "default": "Service department hours"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "When we’re open"
    },
    {
      "key": "intro",
      "type": "textarea",
      "label": "Intro line"
    },
    {
      "key": "afterTitle",
      "type": "text",
      "label": "After-hours card title",
      "default": "After hours"
    },
    {
      "key": "afterText",
      "type": "textarea",
      "label": "After-hours card copy"
    },
    {
      "key": "rooftops",
      "type": "list",
      "label": "Locations",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link"
        },
        {
          "key": "hoursRows",
          "type": "list",
          "label": "Hours by department",
          "fields": [
            {
              "key": "department",
              "type": "text",
              "label": "Department"
            },
            {
              "key": "summary",
              "type": "text",
              "label": "Hours"
            }
          ]
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "sh",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8,
        "background": "paper"
      },
      "children": [
        {
          "id": "sh-head",
          "type": "row",
          "props": {
            "gap": 4
          },
          "children": [
            {
              "id": "sh-headcol",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "sh-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "{{eyebrow}}",
                    "text": "{{heading}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "sh-intro",
                  "type": "text",
                  "props": {
                    "text": "{{intro}}",
                    "width": "full"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sh-grid",
          "type": "row",
          "props": {
            "gap": 4,
            "stackOn": "never"
          },
          "children": [
            {
              "id": "sh-card",
              "type": "column",
              "props": {
                "span": 3,
                "repeat": "rooftops"
              },
              "children": [
                {
                  "id": "sh-name",
                  "type": "heading",
                  "props": {
                    "text": "{{name}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "sh-depts",
                  "type": "row",
                  "props": {
                    "gap": 0
                  },
                  "children": [
                    {
                      "id": "sh-dept",
                      "type": "column",
                      "props": {
                        "span": 12,
                        "repeat": "hoursRows"
                      },
                      "children": [
                        {
                          "id": "sh-dept-t",
                          "type": "text",
                          "props": {
                            "text": "<strong>{{department}}</strong><br>{{summary}}",
                            "width": "full"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "sh-phone",
                  "type": "text",
                  "props": {
                    "text": "<a href=\"{{phoneUrl}}\">{{phone}}</a>",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "sh-after",
              "type": "column",
              "props": {
                "span": 3
              },
              "children": [
                {
                  "id": "sh-after-h",
                  "type": "heading",
                  "props": {
                    "text": "{{afterTitle}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "sh-after-t",
                  "type": "text",
                  "props": {
                    "text": "{{afterText}}",
                    "width": "full"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
