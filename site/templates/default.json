{
  "version": 2,
  "id": "default",
  "name": "Site template",
  "conditions": [
    {
      "type": "entireSite",
      "ref": null
    }
  ],
  "css": "[data-bz-node=\"header\"] .bz-block { padding-block: 0; }\n[data-bz-node=\"main-nav\"] .bz-nav { background: var(--ink-dark); border: 1px solid rgba(255,255,255,.1); border-radius: 10px; padding: 6px 10px; gap: 4px; }\n[data-bz-node=\"main-nav\"] .bz-navitem > a { font: 700 12.5px / 1 var(--font-heading); text-transform: uppercase; letter-spacing: .02em; color: #fff; padding: 12px 10px; }\n[data-bz-node=\"main-nav\"] .bz-navitem > a:hover { color: rgba(255,255,255,.75); }\n@media (max-width: 1100px) { [data-bz-node=\"main-nav\"] .bz-nav { background: none; border: 0; } }\n@media (max-width: 640px) { [data-bz-node=\"header-brand\"] { grid-column: span 9; } [data-bz-node=\"header-nav\"] { grid-column: span 3; } [data-bz-node=\"logo\"] img { height: 34px; width: auto; } }",
  "nodes": [
    {
      "id": "utility",
      "type": "sharedSection",
      "props": {
        "sectionId": "utility-bar",
        "values": {
          "phone": "(555) 010-0148",
          "phoneUrl": "tel:+15550100148",
          "address": "1250 Commerce Parkway, Riverton, TX 75001",
          "facebook": "https://facebook.com",
          "instagram": "https://instagram.com",
          "linkedin": "https://linkedin.com",
          "x": "https://x.com",
          "youtube": "https://youtube.com"
        }
      }
    },
    {
      "id": "header",
      "type": "section",
      "props": {
        "width": "full",
        "paddingY": 3,
        "background": "ink"
      },
      "styles": {
        "base": {
          "paddingLeft": 24,
          "paddingRight": 24
        }
      },
      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center",
            "stackOn": "never"
          },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "height": 40,
                    "image": {
                      "src": "/logo-white.svg",
                      "alt": "Summit Ridge Truck Center",
                      "width": 260,
                      "height": 48
                    }
                  }
                }
              ]
            },
            {
              "id": "header-nav",
              "type": "column",
              "props": {
                "span": 8,
                "align": "center"
              },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "main",
                    "layout": "horizontal",
                    "align": "end",
                    "collapseOnMobile": true
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "content",
      "type": "contentArea",
      "props": {
        "label": "Page content"
      }
    },
    {
      "id": "footer",
      "type": "sharedSection",
      "props": {
        "sectionId": "site-footer",
        "values": {
          "facebook": "https://facebook.com",
          "instagram": "https://instagram.com",
          "linkedin": "https://linkedin.com",
          "x": "https://x.com",
          "youtube": "https://youtube.com"
        }
      }
    }
  ]
}
