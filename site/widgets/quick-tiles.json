{
  "version": 1,
  "id": "quick-tiles",
  "label": "Quick-link tiles",
  "category": "content",
  "origin": "ai",
  "description": "A two-by-two grid of dark link tiles, each with an icon, a label and an arrow. Used beside the hero headline.",
  "props": [
    {
      "key": "items",
      "type": "list",
      "label": "Tiles",
      "fields": [
        {
          "key": "label",
          "type": "text",
          "label": "Label"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Links to"
        },
        {
          "key": "icon",
          "type": "select",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "wrench",
              "label": "Wrench"
            },
            {
              "value": "box",
              "label": "Parts box"
            },
            {
              "value": "gear",
              "label": "Gear"
            },
            {
              "value": "pin",
              "label": "Map pin"
            },
            {
              "value": "check",
              "label": "Check mark"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "users",
              "label": "People"
            },
            {
              "value": "dollar",
              "label": "Dollar"
            }
          ]
        }
      ]
    }
  ],
  "html": "<nav class=\"qt\" aria-label=\"Quick links\">{{#each items}}<a class=\"qt__tile\" href=\"{{url}}\"><span class=\"qt__ic\"><span class=\"qt__glyph qt__glyph--{{icon}}\" aria-hidden=\"true\"></span></span><span class=\"qt__l\">{{label}}</span><span class=\"qt__arrow\" aria-hidden=\"true\">→</span></a>{{/each}}</nav>",
  "css": ".qt { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }\n.qt__tile { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-radius: var(--radius-card); background: rgba(39, 38, 35, 0.82); border: 1px solid rgba(255, 255, 255, 0.08); color: #fff; text-decoration: none; backdrop-filter: blur(6px); transition: background-color .15s ease, transform .15s ease; }\n.qt__tile:hover { background: rgba(39, 38, 35, 0.95); transform: translateY(-1px); }\n.qt__ic { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 8px; background: #fff; color: var(--ink); }\n.qt__glyph { display: block; width: 20px; height: 20px; background: currentColor; -webkit-mask: no-repeat center / contain; mask: no-repeat center / contain; }\n.qt__l { flex: 1; font: 700 15px / 1.2 var(--font-heading); text-transform: uppercase; letter-spacing: .01em; }\n.qt__arrow { flex: none; font-size: 16px; }\n@media (max-width: 640px) { .qt { grid-template-columns: 1fr; } }\n.qt__glyph--truck { -webkit-mask-image: url(\"/icons/International_Icon_Truck_Black.svg\"); mask-image: url(\"/icons/International_Icon_Truck_Black.svg\"); }\n.qt__glyph--wrench { -webkit-mask-image: url(\"/icons/International_Icon_Tool_Black.svg\"); mask-image: url(\"/icons/International_Icon_Tool_Black.svg\"); }\n.qt__glyph--box { -webkit-mask-image: url(\"/icons/International_Icon_Package_Black.svg\"); mask-image: url(\"/icons/International_Icon_Package_Black.svg\"); }\n.qt__glyph--gear { -webkit-mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M12.22%202h-.44a2%202%200%200%200-2%202v.18a2%202%200%200%201-1%201.73l-.43.25a2%202%200%200%201-2%200l-.15-.08a2%202%200%200%200-2.73.73l-.22.38a2%202%200%200%200%20.73%202.73l.15.1a2%202%200%200%201%201%201.72v.51a2%202%200%200%201-1%201.74l-.15.09a2%202%200%200%200-.73%202.73l.22.38a2%202%200%200%200%202.73.73l.15-.08a2%202%200%200%201%202%200l.43.25a2%202%200%200%201%201%201.73V20a2%202%200%200%200%202%202h.44a2%202%200%200%200%202-2v-.18a2%202%200%200%201%201-1.73l.43-.25a2%202%200%200%201%202%200l.15.08a2%202%200%200%200%202.73-.73l.22-.39a2%202%200%200%200-.73-2.73l-.15-.08a2%202%200%200%201-1-1.74v-.5a2%202%200%200%201%201-1.74l.15-.09a2%202%200%200%200%20.73-2.73l-.22-.38a2%202%200%200%200-2.73-.73l-.15.08a2%202%200%200%201-2%200l-.43-.25a2%202%200%200%201-1-1.73V4a2%202%200%200%200-2-2z'%2F%3E%3Ccircle%20cx%3D'12'%20cy%3D'12'%20r%3D'3'%2F%3E%3C%2Fsvg%3E\"); mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M12.22%202h-.44a2%202%200%200%200-2%202v.18a2%202%200%200%201-1%201.73l-.43.25a2%202%200%200%201-2%200l-.15-.08a2%202%200%200%200-2.73.73l-.22.38a2%202%200%200%200%20.73%202.73l.15.1a2%202%200%200%201%201%201.72v.51a2%202%200%200%201-1%201.74l-.15.09a2%202%200%200%200-.73%202.73l.22.38a2%202%200%200%200%202.73.73l.15-.08a2%202%200%200%201%202%200l.43.25a2%202%200%200%201%201%201.73V20a2%202%200%200%200%202%202h.44a2%202%200%200%200%202-2v-.18a2%202%200%200%201%201-1.73l.43-.25a2%202%200%200%201%202%200l.15.08a2%202%200%200%200%202.73-.73l.22-.39a2%202%200%200%200-.73-2.73l-.15-.08a2%202%200%200%201-1-1.74v-.5a2%202%200%200%201%201-1.74l.15-.09a2%202%200%200%200%20.73-2.73l-.22-.38a2%202%200%200%200-2.73-.73l-.15.08a2%202%200%200%201-2%200l-.43-.25a2%202%200%200%201-1-1.73V4a2%202%200%200%200-2-2z'%2F%3E%3Ccircle%20cx%3D'12'%20cy%3D'12'%20r%3D'3'%2F%3E%3C%2Fsvg%3E\"); }\n.qt__glyph--pin { -webkit-mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%20stroke-wi