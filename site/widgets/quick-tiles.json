201%20.29-.9l5.17-.76a2.12%202.12%200%200%200%201.6-1.16z'%2F%3E%3C%2Fsvg%3E\"); mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M11.5%202.3a.53.53%200%200%201%20.95%200l2.31%204.68a2.12%202.12%200%200%200%201.6%201.16l5.16.76a.53.53%200%200%201%20.3.9l-3.74%203.64a2.12%202.12%200%200%200-.61%201.88l.88%205.14a.53.53%200%200%201-.77.56l-4.62-2.43a2.12%202.12%200%200%200-1.97%200L6.4%2021.01a.53.53%200%200%201-.77-.56l.88-5.13a2.12%202.12%200%200%200-.61-1.88L2.16%209.79a.53.53%200%200%201%20.29-.9l5.17-.76a2.12%202.12%200%200%200%201.6-1.16z'%2F%3E%3C%2Fsvg%3E\"); }\n.qt__glyph--users { -webkit-mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M16%2021v-2a4%204%200%200%200-4-4H6a4%204%200%200%200-4%204v2'%2F%3E%3Ccircle%20cx%3D'9'%20cy%3D'7'%20r%3D'4'%2F%3E%3Cpath%20d%3D'M22%2021v-2a4%204%200%200%200-3-3.87'%2F%3E%3Cpath%20d%3D'M16%203.13a4%204%200%200%201%200%207.75'%2F%3E%3C%2Fsvg%3E\"); mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'M16%2021v-2a4%204%200%200%200-4-4H6a4%204%200%200%200-4%204v2'%2F%3E%3Ccircle%20cx%3D'9'%20cy%3D'7'%20r%3D'4'%2F%3E%3Cpath%20d%3D'M22%2021v-2a4%204%200%200%200-3-3.87'%2F%3E%3Cpath%20d%3D'M16%203.13a4%204%200%200%201%200%207.75'%2F%3E%3C%2Fsvg%3E\"); }\n.qt__glyph--dollar { -webkit-mask-image: url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'black'%2