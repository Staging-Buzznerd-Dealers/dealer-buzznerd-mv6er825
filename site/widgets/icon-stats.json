          "label": "Figure"
        },
        {
          "key": "label",
          "type": "text",
          "label": "Caption"
        }
      ]
    }
  ],
  "html": "<ul class=\"is\">{{#each items}}<li class=\"is__card\"><span class=\"is__ring\"><span class=\"is__glyph is__glyph--{{icon}}\" aria-hidden=\"true\"></span></span><strong class=\"is__v\">{{value}}</strong><span class=\"is__l\">{{label}}</span></li>{{/each}}</ul>",
