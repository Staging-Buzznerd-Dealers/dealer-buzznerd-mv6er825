              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "wrench",
              "label": "Wrench"
            },
            {
              "value": "box",
              "label": "Parts box"
            },
            {
              "value": "gear",
              "label": "Gear"
            },
            {
              "value": "pin",
              "label": "Map pin"
            },
            {
              "value": "check",
              "label": "Check mark"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "users",
              "label": "People"
            },
            {
              "value": "dollar",
              "label": "Dollar"
            }
