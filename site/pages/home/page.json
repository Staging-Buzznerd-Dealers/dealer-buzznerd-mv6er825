            {
              "id": "fin-cta-col",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "fin-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "get-financing"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "reviews",
      "type": "sharedSection",
      "props": {
        "sectionId": "quote-carousel",
        "values": {
          "quotes": [
            {
              "quote": "They kept three of our trucks down for less than 48 hours combined all year. That’s the difference a good service team makes.",
              "name": "Dana Whitfield",
              "role": "Fleet Manager, Whitfield Freight"
            },
            {
              "quote": "They had the exact spec I needed in stock and had it road-ready in two days. Straight answers from start to finish.",
              "name": "Luis Ortega",
              "role": "Owner-Operator, Ortega Hauling"
            },
            {
              "quote": "The parts counter is the best in the region. If it isn’t on the shelf, it’s here the next morning.",
              "name": "Priya Natarajan",
              "role": "Shop Foreman, Red River Municipal Fleet"
            }
          ]
        }
      }
    },
