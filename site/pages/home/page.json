{
  "version": 2,
  "nodes": [
    {
      "id": "hero",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "minHeight": 600,
          "display": "flex",
          "alignItems": "center",
          "paddingTop": 72,
          "paddingBottom": 72,
          "backgroundImage": "/images/hero-truck.webp",
          "backgroundSize": "cover",
          "backgroundPosition": "center right",
          "background": "inkDark"
        },
        "mobile": {
          "minHeight": 0,
          "paddingTop": 48,
          "paddingBottom": 48
        }
      },
      "children": [
        {
          "id": "hero-row",
          "type": "row",
          "props": {
            "gap": 7,
            "align": "center",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "hero-copy",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "hero-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "New & used commercial trucks",
                    "text": "North Texas’s premier commercial truck dealer",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "hero-sub",
                  "type": "text",
                  "props": {
                    "text": "Summit Ridge Truck Center is a full-service commercial truck dealer for Texas and Oklahoma, offering new and used Class 8 trucks, certified service, and OEM parts to keep your fleet moving.",
                    "width": "full"
                  }
                },
                {
                  "id": "hero-search",
                  "type": "widget",
                  "props": {
                    "widget": "inventory-search",
                    "config": {
                      "placeholder": "Search by stock #, model, or VIN"
                    },
                    "snapshot": {
                      "types": []
                    }
                  }
                }
              ]
            },
            {
              "id": "hero-links",
              "type": "column",
              "props": {
                "span": 5,
                "align": "center"
              },
              "children": [
                {
                  "id": "hero-tiles",
                  "type": "quick-tiles",
                  "props": {
                    "items": [
                      {
                        "label": "New trucks",
                        "url": "/store/inventory?condition=new",
                        "icon": "truck"
                      },
                      {
                        "label": "Used trucks",
                        "url": "/store/inventory?condition=used",
                        "icon": "truck"
                      },
                      {
                        "label": "Schedule service",
                        "url": "/#service",
                        "icon": "wrench"
                      },
                      {
                        "label": "Order parts",
                        "url": "/store/parts",
                        "icon": "box"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "featured-band",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8
      },
      "children": [
        {
          "id": "featured-h",
          "type": "heading",
          "props": {
            "eyebrow": "Inventory",
            "text": "Featured listings",
            "headingLevel": 2
          }
        },
        {
          "id": "featured",
          "type": "widget",
          "props": {
            "widget": "inventory-carousel",
            "config": {
              "limit": 8
            },
            "behaviour": "carousel",
            "behaviourOptions": "{\"label\":\"Featured listings\",\"perMove\":1}",
            "snapshot": {
              "listings": []
            }
          }
        },
        {
          "id": "featured-more",
          "type": "buttons",
          "props": {
            "items": [
              {
                "ctaId": "browse-inventory",
                "style": "link"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "offer",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 9,
        "background": "ink",
        "anchor": "why-us"
      },
      "children": [
        {
          "id": "offer-h",
          "type": "heading",
          "props": {
            "eyebrow": "Why Summit Ridge",
            "text": "What we offer",
            "headingLevel": 2,
            "align": "center"
          }
        },
        {
          "id": "offer-stats",
          "type": "icon-stats",
          "props": {
            "items": [
              {
                "icon": "gear",
                "value": "120+",
                "label": "Service technicians"
              },
              {
                "icon": "pin",
                "value": "90+",
                "label": "Service bays"
              },
              {
                "icon": "wrench",
                "value": "35",
                "label": "Parts delivery vehicles"
              },
              {
                "icon": "check",
                "value": "12+",
                "label": "Certified DOT safety inspectors"
              },
              {
                "icon": "star",
                "value": "AC",
                "label": "Factory-trained AC technicians"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "depts",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8,
        "anchor": "service"
      },
      "children": [
        {
          "id": "depts-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "start",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "service-col",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "service-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/images/service-bay.webp",
                      "alt": "Technicians walking through an open service bay beside a truck",
                      "width": 1400,
                      "height": 933
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "service-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Service center",
                    "text": "Certified maintenance & repair",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "service-text",
                  "type": "text",
                  "props": {
                    "text": "Factory-trained technicians, genuine parts, and same-week appointments to keep your trucks on the road longer.",
                    "width": "full"
                  }
                },
                {
                  "id": "service-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "book-service"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "parts-col",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "parts-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/images/parts-showroom.webp",
                      "alt": "Parts team walking past a truck in a glass-walled showroom",
                      "width": 1400,
                      "height": 933
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "parts-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Parts department",
                    "text": "OEM parts, in stock",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "parts-text",
                  "type": "text",
                  "props": {
                    "text": "Order online or call our parts desk. Most in-stock orders ship same day.",
                    "width": "full"
                  }
                },
                {
                  "id": "parts-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "shop-parts"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "financing",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8,
        "background": "ink",
        "anchor": "financing"
